                      "id":  "9d3c1a71-telegram-trigger-0001",
                      "name":  "Telegram Trigger",
                      "type":  "n8n-nodes-base.telegramTrigger",
                      "typeVersion":  1,
                      "position":  [
                                       280,
                                       300
                                   ],
                      "webhookId":  "telegram-expenses"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Parsing robusto: aceita \u0027mercado 85,50\u0027, \u0027mercado 1.234,56\u0027 e\n// \u0027mercado 85,50 alimentacao\u0027. Devolve { ok, erro } em vez de lancar, para\n// o Telegram receber uma resposta de feedback.\nfunction limparNumero(valor) {\n  return String(valor)\n    .trim()\n    .replace(/^[Rr]\\$\\s*/, \u0027\u0027)\n    .replace(/\\s/g, \u0027\u0027);\n}\n\nfunction parseNumero(valor) {\n  let v = limparNumero(valor);\n  if (!v) return Number.NaN;\n  // pt-BR: virgula e o separador decimal; ponto pode ser milhar (1.234,56)\n  // ou decimal (85.50).\n  if (v.includes(\u0027,\u0027) \u0026\u0026 v.includes(\u0027.\u0027)) {\n    v = v.replace(/\\./g, \u0027\u0027).replace(\u0027,\u0027, \u0027.\u0027);\n  } else if (v.includes(\u0027,\u0027)) {\n    v = v.replace(\u0027,\u0027, \u0027.\u0027);\n  }\n  const n = Number(v);\n  return Number.isFinite(n) ? n : Number.NaN;\n}\n\nconst mensagem = $input.first().json.message ?? {};\nconst texto = typeof mensagem.text === \u0027string\u0027 ? mensagem.text.trim() : \u0027\u0027;\nconst base = {\n  telegramId: String(mensagem?.from?.id ?? \u0027\u0027),\n  chatId: String(mensagem?.chat?.id ?? \u0027\u0027),\n};\n\nconst formato = \u0027Formato: \u003cdescricao\u003e \u003cvalor\u003e [categoria]. Ex.: mercado 85,50 alimentacao\u0027;\nif (!texto) {\n  return [{ json: { ...base, ok: false, erro: \u0027Nao recebi um texto. \u0027 + formato } }];\n}\n\nconst partes = texto.split(/\\s+/);\n\n// O valor e o token mais a direita que parsa como numero (aceita categoria\n// opcional apos ele e descricao com varias palavras a esquerda).\nlet indiceValor = -1;\nfor (let i = partes.length - 1; i \u003e= 0; i--) {\n  if (!Number.isNaN(parseNumero(partes[i]))) {\n    indiceValor = i;\n    break;\n  }\n}\n\nif (indiceValor \u003c 0) {\n  return [{ json: { ...base, ok: false, erro: \u0027Nao identifiquei o valor. \u0027 + formato } }];\n}\n\nconst valorReais = parseNumero(partes[indiceValor]);\nconst descricao = partes\n  .slice(0, indiceValor)\n  .filter((p) =\u003e !/^[Rr]\\$$/.test(p))\n  .join(\u0027 \u0027)\n  .trim();\nconst categoria = partes.slice(indiceValor + 1).join(\u0027 \u0027).toLowerCase() || undefined;\n\nif (!descricao) {\n  return [{ json: { ...base, ok: false, erro: \u0027Faltou a descricao do gasto. \u0027 + formato } }];\n}\n\nreturn [\n  {\n    json: {\n      ...base,\n      ok: true,\n      valorTexto: partes[indiceValor],\n      valorCentavos: Math.round(valorReais * 100),\n      descricao,\n      categoria,\n      dataGasto: new Date().toISOString().slice(0, 10),\n    },\n  },\n];"
                                     },
