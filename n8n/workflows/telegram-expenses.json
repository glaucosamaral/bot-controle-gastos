{
  "name": "telegram-expenses",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "id": "9d3c1a71-telegram-trigger-0001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "telegram-expenses"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst parts = item.message.text.trim().split(/\\s+/);\n\nif (parts.length < 3) {\n  throw new Error('Formato esperado: descricao valor categoria');\n}\n\nconst reais = Number(parts[parts.length - 2].replace(',', '.'));\n\nreturn [{\n  json: {\n    telegramId: String(item.message.from.id),\n    descricao: parts.slice(0, -2).join(' '),\n    valorCentavos: Math.round(reais * 100),\n    categoria: parts[parts.length - 1].toLowerCase(),\n  },\n}];",
        "mode": "runOnceForAllItems"
      },
      "id": "9d3c1a71-prepare-expense-0002",
      "name": "Preparar dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:3001/api/v1/expenses",
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "9d3c1a71-http-save-expense-0003",
      "name": "Salvar na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Preparar dados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar dados": {
      "main": [
        [
          {
            "node": "Salvar na API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}