# Copie para .env e preencha (este arquivo NAO vai para o servidor com valores reais)
POSTGRES_USER=expenses_user
POSTGRES_PASSWORD=troque_aqui
POSTGRES_DB=expenses_db
DATABASE_URL=postgres://expenses_user:troque_aqui@postgres:5432/expenses_db

# Backend
BACKEND_PORT=3001

# Segredo para assinar os JWT de sessao (troque em producao)
JWT_SECRET=troque_aqui_secret_forte_$em_producao
# Validade da sessao em segundos (7 dias)
JWT_EXPIRES_IN=604800

# Segredo compartilhado que o n8n envia em X-Webhook-Secret ao POST /expenses
N8N_WEBHOOK_SECRET=troque_aqui_secret_webhook

# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGIN=http://localhost:5173

# Frontend (URL da API vista pelo navegador)
VITE_API_URL=http://localhost:3001/api/v1

# Usuario do bot do Telegram (ex.: @meubot -> meubot) usado pelo widget de login
VITE_TELEGRAM_BOT_USERNAME=meu_bot_username

# n8n: URL publica HTTPS que o Telegram usa para chamar o webhook.
# Local: http://localhost:5678/ | Exposto via tunel: https://SEU_NO.SUA_TAILNET.ts.net/
N8N_WEBHOOK_URL=https://troque_aqui.ts.net/

# Telegram (crie o bot com @BotFather)
TELEGRAM_BOT_TOKEN=troque_aqui
